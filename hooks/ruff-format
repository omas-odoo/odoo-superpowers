#!/usr/bin/env bash
# PostToolUse hook for Edit | Write. Runs `ruff format` on the edited file
# if it's a .py file and ruff is installed. Silent no-op otherwise.

set -euo pipefail

payload="$(cat)"

if command -v jq >/dev/null 2>&1; then
    file_path="$(printf '%s' "$payload" | jq -r '.tool_input.file_path // .tool_input.path // empty')"
else
    file_path="$(printf '%s' "$payload" | grep -oE '"(file_path|path)"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -E 's/.*"[^"]*"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/')"
fi

# Not a python file, or no path: silent exit.
case "${file_path:-}" in
    *.py) ;;
    *) exit 0 ;;
esac

# File must exist (Write to a new file is fine; Edit that failed isn't).
[ -f "$file_path" ] || exit 0

# Ruff not installed? Silent exit — don't block edits on a missing dev tool.
command -v ruff >/dev/null 2>&1 || exit 0

# Run ruff format. Capture output; surface only if it fails.
if ! out="$(ruff format "$file_path" 2>&1)"; then
    printf '[odoo-superpowers] ruff format failed on %s:\n%s\n' "$file_path" "$out" >&2
    # Don't exit 2 — formatting failure isn't worth blocking on; just report.
fi

exit 0
