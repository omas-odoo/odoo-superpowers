{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Copy this into a project's .claude/settings.json (or merge into ~/.claude/settings.json). The plugin's hooks add the git-push gate and ruff auto-format on top. DISCORD_WEBHOOK_URL is a Phase 2 placeholder — leave empty until the uncertainty loop is turned on.",
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(dropdb:*)"
    ]
  },
  "env": {
    "DISCORD_WEBHOOK_URL": ""
  }
}
